# Exercise the real role-dispatch executable without shell quoting or new dependencies.
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(root "${TEST_ROOT}/prepare-cli-${suffix} with spaces")
file(MAKE_DIRECTORY "${root}")
file(WRITE "${root}/corpus.tsv" "10\tcat cat dog\n20\tdog bird\n30\tcat bird bird\n")

function(expect_failure)
  execute_process(COMMAND "${KRETRIEVE}" prepare ${ARGN}
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if("${result}" STREQUAL "0" OR out MATCHES "Prepared")
    message(FATAL_ERROR "prepare unexpectedly succeeded: ${ARGN}\n${out}\n${err}")
  endif()
  if(NOT "${result}" MATCHES "^[12]$" OR NOT err MATCHES "prepare:")
    message(FATAL_ERROR "prepare did not fail cleanly: ${ARGN}\n${result}\n${err}")
  endif()
endfunction()

expect_failure()
expect_failure(--input)
expect_failure(--input "${root}/corpus.tsv" --output "${root}/prepared")
expect_failure(--unknown value)
foreach(count IN ITEMS 0 -1 +1 1x 1.5 18446744073709551616)
  expect_failure(--input "${root}/corpus.tsv" --output "${root}/prepared" --shards "${count}")
endforeach()
expect_failure(--input "${root}/corpus.tsv" --output "${root}/prepared" --shards 2 --shards 3)
expect_failure(--input "${root}/corpus.tsv" --input "${root}/corpus.tsv"
  --output "${root}/prepared" --shards 2)
expect_failure(--input "${root}/corpus.tsv" --output "${root}/prepared"
  --output "${root}/prepared" --shards 2)
expect_failure(--input "${root}/missing.tsv" --output "${root}/prepared" --shards 2)
file(WRITE "${root}/bad.tsv" "10\tcat\n10\tdog\n")
expect_failure(--input "${root}/bad.tsv" --output "${root}/prepared" --shards 2)
file(WRITE "${root}/empty.tsv" "")
expect_failure(--input "${root}/empty.tsv" --output "${root}/prepared" --shards 2)
if(EXISTS "${root}/prepared")
  message(FATAL_ERROR "invalid input created an output directory")
endif()
expect_failure(--input "${root}/corpus.tsv" --output "${root}/missing-parent/prepared" --shards 2)

execute_process(COMMAND "${KRETRIEVE}" prepare --shards 3
  --output "${root}/prepared" --input "${root}/corpus.tsv"
  RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT "${result}" STREQUAL "0" OR NOT out MATCHES "Prepared 3 shards")
  message(FATAL_ERROR "prepare failed: ${result}\n${out}\n${err}")
endif()
foreach(shard IN ITEMS 0 1 2)
  if(NOT EXISTS "${root}/prepared/shard-${shard}.tsv")
    message(FATAL_ERROR "missing partition ${shard}")
  endif()
endforeach()
if(NOT EXISTS "${root}/prepared/global_stats.bin")
  message(FATAL_ERROR "missing global statistics")
endif()
file(READ "${root}/prepared/shard-1.tsv" partition)
if(NOT "${partition}" STREQUAL "10\tcat cat dog\n")
  message(FATAL_ERROR "incorrect deterministic partition: ${partition}")
endif()
file(SHA256 "${root}/prepared/global_stats.bin" before)
expect_failure(--input "${root}/corpus.tsv" --output "${root}/prepared" --shards 3)
file(SHA256 "${root}/prepared/global_stats.bin" after)
if(NOT "${before}" STREQUAL "${after}")
  message(FATAL_ERROR "failed prepare overwrote existing statistics")
endif()

# This directory was uniquely generated by this test; no user paths are removed.
file(REMOVE_RECURSE "${root}")
